# Copy this file to .env and fill in your own values. Never commit .env.
# DO NOT WRITE ANY API KEYS IN THIS FILE. 
# This file is for local development only. Use environment variables in production.

# --- Model helper (src/fsai_agents/core/llm/models.py) ---

# Required: key for the main (API) route
ANTHROPIC_API_KEY=your-api-key-here
OPENROUTER_API_KEY=your-api-key-here
# Optional: defaults are shown, so you can leave these out
MODEL_API_NAME=api-model-name
MODEL_MAIN_ROUTE=api
MODEL_LOCAL_NAME=local-model-name
OLLAMA_URL=http://localhost:11434

LANGFUSE_PUBLIC_KEY=pk-lf-your-key-here
LANGFUSE_SECRET_KEY=sk-lf-your-key-here
LANGFUSE_HOST=http://localhost:3000
# Timeouts in seconds
MODEL_API_TIMEOUT=60
MODEL_LOCAL_TIMEOUT=120
